// Prisma Schema for StellarFlow Backend
// PostgreSQL database schema for price history tracking

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Price History Model
// Stores historical exchange rates for sparkline charts
model PriceHistory {
  id        Int      @id @default(autoincrement())
  currency  String   @db.VarChar(10) // e.g., "GHS", "KES"
  rate      Decimal  @db.Decimal(20, 10) // High precision for exchange rates
  source    String   @db.VarChar(100) // Source API name
  timestamp DateTime @db.Timestamp(3) // When the rate was recorded

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Unique constraint to prevent duplicate entries at same timestamp from same source
  @@unique([currency, source, timestamp])
  // Indexes for efficient sparkline queries
  @@index([currency, timestamp])
  @@index([timestamp])
}

// Currency Configuration Model
// Stores supported currencies and their metadata
model Currency {
  code     String  @id @db.VarChar(10) // e.g., "GHS", "KES"
  name     String  @db.VarChar(100) // Full name e.g., "Ghanaian Cedi"
  symbol   String  @db.VarChar(5) // Currency symbol e.g., "₵", "KES"
  decimals Int     @default(2) // Decimal places for display
  isActive Boolean @default(true) // Whether this currency is currently supported

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PriceRecord {
  id        Int      @id @default(autoincrement())
  currency  String
  value     Float
  timestamp DateTime
}

// Provider Reputation Model
// Tracks API reliability and performance
model ProviderReputation {
  id                   Int       @id @default(autoincrement())
  providerName         String    @db.VarChar(100) // e.g., "CoinGecko", "ExchangeRateAPI"
  endpoint             String?   @db.VarChar(255) // Specific endpoint URL or identifier
  status               String    @db.VarChar(20) // "online", "offline", "degraded"
  totalRequests        Int       @default(0) // Total API calls made
  successfulRequests   Int       @default(0) // Successful responses
  failedRequests       Int       @default(0) // Failed responses
  incorrectResponses   Int       @default(0) // Responses with invalid/incorrect data
  averageLatency       Float? // Average response time in ms
  lastSuccess          DateTime? // Last successful response timestamp
  lastFailure          DateTime? // Last failed response timestamp
  lastIncorrect        DateTime? // Last incorrect response timestamp
  consecutiveFailures  Int       @default(0) // Current streak of consecutive failures
  consecutiveIncorrect Int       @default(0) // Current streak of consecutive incorrect responses

  // Reliability metrics
  reliabilityScore Float? // Calculated score (0-100)
  lastUpdated      DateTime @updatedAt

  createdAt DateTime @default(now())

  @@unique([providerName, endpoint])
  // Indexes for quick lookups
  @@index([providerName])
  @@index([status])
  @@index([reliabilityScore])
}

enum RebalancingSwapStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// Durable queue consumed by the component that executes cross-border swaps.
model RebalancingSwap {
  id                String                @id @default(cuid())
  poolKey           String                @db.VarChar(100)
  anchorAccount     String                @db.VarChar(56)
  fromCurrency      String                @db.VarChar(12)
  toCurrency        String                @db.VarChar(12)
  fromAmount        Decimal               @db.Decimal(30, 7)
  estimatedToAmount Decimal               @db.Decimal(30, 7)
  normalizedVolume  Decimal               @db.Decimal(30, 7)
  fromReserveRatio  Decimal               @db.Decimal(8, 7)
  toReserveRatio    Decimal               @db.Decimal(8, 7)
  status            RebalancingSwapStatus @default(QUEUED)
  managerAccounts   String[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([poolKey, status])
  @@index([status, createdAt])
}
